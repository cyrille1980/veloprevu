      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(veloprevu_latence_secondes_bucket{route=\"/predict\"}[5m])) by (le))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(veloprevu_latence_secondes_bucket{route=\"/predict\"}[5m])) by (le))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
