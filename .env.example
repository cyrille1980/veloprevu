# Copier ce fichier en .env et remplacer toutes les valeurs. Le fichier .env n'est jamais versionné.

# Base PostgreSQL de MLflow (backend store)
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=changer-moi

# MinIO (artifact store de MLflow) : mot de passe d'au moins 8 caractères
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=changer-moi-aussi

# Clé exigée par l'API dans l'en-tête X-API-Key
VELOPREVU_API_KEY=changer-cette-cle

# Grafana (utilisateur admin)
GRAFANA_ADMIN_PASSWORD=changer-moi

# --- Côté poste de travail (à exporter dans le terminal, voir README) ---
# MLFLOW_TRACKING_URI=http://localhost:5000
# VELOPREVU_API_URL=http://localhost:8000

# --- Agent (facultatif) : par défaut Ollama en local, aucune clé requise ---
# VELOPREVU_LLM_URL=http://localhost:11434/v1
# VELOPREVU_LLM_MODELE=llama3.1
# VELOPREVU_LLM_API_KEY=
